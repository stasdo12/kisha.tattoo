# Copy this file to .env.local and fill in the values

# Telegram Bot — get token from @BotFather
TELEGRAM_BOT_TOKEN=

# Telegram Chat ID — the chat/group that receives form submissions
# To find your ID: message the bot, then open:
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# DataForSEO — SEO/GEO data API (rank tracking, keyword volume, SERP, AI visibility)
# Get credentials from https://app.dataforseo.com/api-access
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Confirmation mail after the booking form — the Google mailbox and an app password
# from https://myaccount.google.com/apppasswords. Left empty, no mail is sent.
SMTP_USER=
SMTP_PASSWORD=
